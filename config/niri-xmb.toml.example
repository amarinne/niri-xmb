# Merge a theme file's [style] table over the one below, key by key. A theme
# must contain only [style]. Unknown style keys cause an error. See
# themes/dank.toml, themes/noctalia.toml, themes/material-3-expressive.toml,
# and themes/liquid-glass.toml for examples.
# theme = "~/.config/niri-xmb/themes/dank.toml"

bars_enabled = true # false runs only the popup/peek daemon

# With no [[bars]] entries, one bar is created per connected output using the
# defaults below. That is what a fresh install wants, so leave this list empty
# unless you need per-monitor settings.
#
# To configure bars explicitly, uncomment a block and replace the connector
# name with one from `niri msg --json outputs`. A connector that is not
# connected is dropped, so a stale name means no bar on that monitor.
#
# [[bars]]
# output = "HDMI-A-1"          # exact Niri connector name
# edge = "top"                 # "top", "bottom", "left", or "right"
# align = "center"             # "start", "center", or "end" along that edge
# width = 1000                 # 1-8192 px horizontal; 1-512 px vertical
# height = 42                  # 1-512 px horizontal; 1-8192 px vertical
# margin = 56                  # edge distance, 0-8192 logical pixels
# offset = 0                   # aligned shift, -8192 to 8192 logical pixels
# allow_column_join = false    # center drops join a Niri column when true
# show_workspace_labels = false # show workspace names/numbers beside icons
# hide_empty_workspaces = false # omit empty workspaces when true
# show_capsule = true          # draw each workspace as its own pill
# show_active_indicator = true # mark the active window in each workspace
# scroll_to_switch = true      # one ratchet click changes one workspace
# scroll_wrap = true           # wheel navigation wraps at the ends
# scroll_reverse = false       # reverse the wheel direction
# scroll_repeat_ms = 75        # free-spin limit, 0-5000 milliseconds
#
# Additional bars use the same parameters and can differ per monitor. A
# portrait output can opt into the center join zone independently.
#
# [[bars]]
# output = "HDMI-A-2"
# edge = "top"
# align = "center"
# width = 1000
# height = 42
# margin = 56
# offset = 0
# allow_column_join = true
# show_workspace_labels = false
# hide_empty_workspaces = false
# show_capsule = true
# show_active_indicator = true
# scroll_to_switch = true
# scroll_wrap = true
# scroll_reverse = false
# scroll_repeat_ms = 75

[popup]
outputs = "combined" # "focused", "all", or "combined"
surface_mode = "follow_active" # "fixed", "follow_active", or "mirror"
follow_delay_ms = 180 # follow delay, 0-60000 milliseconds
position = "anchored" # "anchored", "cursor", "center", or "fixed"
# Popup spatial values accept logical-pixel numbers or percentage strings.
# Percentages resolve against each host monitor's logical width or height.
# Sizes use 0.1%-100% or 1-8192 px. Fixed positions use -100%-100% or
# -8192-8192 px.
width = 1600       # maximum panel width; for example "80%"
height = 850       # maximum panel height; for example "70%"
fixed_x = 80       # X origin for position = "fixed"; for example "10%"
fixed_y = 80       # Y origin for position = "fixed"; for example "5%"
# width/height cap the panel; each monitor gets a canvas of the size below and
# they are laid out side by side.
canvas_width = 300  # width per output map; for example "20%"
canvas_height = 190 # height per output map; for example "24%"
show_labels = false # workspace and output names
show_titles = false # selected app name, with window-title fallback

# Where the panel sits on each monitor, for position = "anchored". The combined
# panel follows focus between monitors, so the anchor is per output. These stay
# last in [popup]: once a [[popup.placements]] table opens, any bare key after
# it belongs to that table rather than to [popup].
[[popup.placements]]
output = "HDMI-A-1" # exact Niri connector name
x = "right"  # "left", "center", "right"
y = "center" # "top", "center", "bottom"
margin = 48.0 # edge gap, 0-8192 px or 0%-100%

[[popup.placements]]
output = "HDMI-A-2"
x = "left"
y = "center"
margin = 48.0

# Passive overlay while navigating Niri with its own keybinds. Takes no input.
[peek]
enabled = false         # automatically show on matching Niri focus changes
duration_ms = 1200      # linger time, 0-60000 milliseconds
# Peek only follows Niri focused-workspace changes. Window focus, dialogs, and
# pointer crossings do not show it.
# The overlay is click-through by default. With pointer_promote the panel
# rectangle takes pointer input while the overlay is up: moving onto it holds it
# open, and clicking it becomes a full manual session in place. The keyboard is
# never taken, so navigation keybinds keep working while the pointer rests on it.
pointer_promote = false # let the pointer grab the overlay instead of passing through
arm_grace_ms = 150      # click-through grace, 0-60000 milliseconds
demote_ms = 400         # pointer-leave linger, 0-60000 milliseconds
move_popup = false      # allow border movement while an armed peek is active

[behavior]
# "deferred": arrows stage a selection, Enter or a click applies it.
# "live":     arrows move Niri's focus immediately, alt-tab style.
navigation = "deferred"
drag_threshold = 7.0         # drag distance, 0-8192 logical pixels
move_popup = false            # allow pressing and holding the popup border to move it
popup_grab_region = 24.0      # border inset in logical pixels used for popup movement
empty_drop_floats = false    # drop on empty map space creates floating windows
floating_drop_tiles = true   # dropping a floating window on icons tiles it
focus_after_drop = false     # focus the moved window after rearranging
snap_cursor_after_drop = false # keep pointer at release point after a drop
close_on_window_click = true # close after activating a window
close_on_workspace_click = false # close after activating a workspace
close_on_drop = false        # close after a successful drag-and-drop
close_on_external_focus_change = false # close after another surface changes Niri focus
# close_on_outside_click is deprecated and ignored; a manual outside click
# always closes.
replay_outside_click = true # replay the captured click when virtual pointer support exists
close_on_escape = true       # Escape closes the popup

# Optional evdev gamepad input. Disabled by default. Gamepads are read outside
# the Wayland seat; actions apply only while the manual popup is open. Prefer
# stable /dev/input/by-id paths; leave devices empty to discover
# *-event-joystick and *-event-gamepad symlinks. Hotplug is automatic. Reading
# /dev/input needs access: install the project udev uaccess rule
# (udev/60-niri-xmb-gamepad.rules) or use the "input" group.
#
# preset: "none" uses only the buttons map; "auto" detects each device from its
# name, USB identity, and capabilities (Flydigi VADER4 and xpad-compatible pads
# use "xbox"; Sony/DualShock/DualSense use "ds4"); "xbox" and "ds4" force a
# layout. Explicit buttons below override preset entries by evdev code.
# D-pad hat axes (ABS_HAT0X/Y) are translated to the configured BTN_DPAD_*
# actions, so controllers without BTN_DPAD_* key events work.
# Actions: up, down, left, right, tab, back (previous output), confirm, close,
# and open (show the manual popup from hidden/peek). open_combo holds at least
# two unique button names/codes together; empty disables it. The completing
# press emits open instead of that button's action, and repeats are suppressed
# until a combo button is released.
[gamepad]
enabled = false
preset = "auto"
devices = []
open_combo = ["BTN_SELECT", "BTN_START"]

[gamepad.buttons]
# BTN_SOUTH = "confirm"
# BTN_EAST = "close"
# "0x130" = "close"     # numeric overrides work too
# BTN_DPAD_UP = "up"
# BTN_DPAD_DOWN = "down"
# BTN_DPAD_LEFT = "left"
# BTN_DPAD_RIGHT = "right"
# BTN_TL = "back"
# BTN_TR = "tab"

[animation]
enabled = true        # false applies every visual change immediately
panel_ms = 140.0    # panel transition, 0-60000 milliseconds
emphasis_ms = 180.0 # emphasis transition, 0-60000 milliseconds
scroll_ms = 165.0   # scroll transition, 0-60000 milliseconds
open_scale = 0.94   # opening scale, 0.1-2.0; 1.0 disables scale

# Primary popup colours and proportions. Colours are #RRGGBB or #AARRGGBB.
# Style lengths use 0-2048 px. Font sizes use 1-512 px. Icon sizes use
# 1-1024 px. Alpha values use 0.0-1.0.
[style]
background = "#f21b2530"       # popup gradient, top stop
background_end = "#f20d1117"   # popup gradient, bottom stop
surface = "#661d2022"           # secondary surface/floating backing colour
surface_hover = "#266ed2ff"     # pointer-hover overlay
border = "#5c8aa5c0"            # primary outline
border_soft = "#2a8aa5c0"      # canvas dividers, inactive marks
accent = "#ff6ed2ff"            # manual or armed-peek input border
selection_border = "#666ed2ff" # retained selection-outline colour
text = "#ffe1e2e5"              # primary labels and selected title
muted = "#ffc0c7cd"             # secondary labels
urgent = "#ffffb4ab"            # urgent-window indicator and workspace marker colour
urgent_indicator = "glow"       # expected value: "none", "ring", "glow", or "badge"
urgent_ring_width = 1.25         # urgent ring stroke width in logical pixels
urgent_ring_padding = 2.0        # gap between an urgent icon and its ring
urgent_glow_spread = 6.0         # glow distance behind icon, in logical pixels
urgent_glow_alpha = 0.18         # glow opacity from 0.0 to 1.0
urgent_badge_radius = 3.5        # top-right badge-dot radius in logical pixels
shadow = "#4e000000"           # panel drop shadow
floating_backing = "#be0c1016" # disc behind floating icons and the drag ghost

radius = 14.0       # small elements, e.g. the urgency ring
panel_radius = 20.0 # the popup panel itself
border_width = 1.0  # logical-pixel outline thickness
icon_size = 28      # normal app icon size in logical pixels
icon_size_focused = 40 # selected icon; emphasis by scale, not by outline
dim_alpha = 0.45       # opacity of icons outside the selected workspace
gap = 8.0              # bar spacing

# Popup proportions.
panel_padding = 14.0   # panel edge to canvas
canvas_gap = 12.0      # between one monitor's canvas and the next
column_gap = 10.0      # added to icon_size_focused for the horizontal step
stack_gap = 6.0        # added to icon_size inside a vertically stacked column
row_gap = 16.0         # added to icon_size_focused for the vertical step
shadow_offset = 6.0    # shadow displacement in logical pixels
shadow_spread = 4.0    # extra size of the softer shadow pass
empty_dot_radius = 3.0 # stands in for an empty workspace
label_font_size = 11.0 # workspace/output label size
title_font_size = 10.0 # selected application title size
