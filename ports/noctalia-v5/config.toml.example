# Noctalia v5 plugin port for niri-xmb.
#
# Point the path source at this repository on the target machine.

[plugins]
enabled = ["amarinne/niri-xmb"]

[[plugins.source]]
name = "niri-xmb-local"
kind = "path"
location = "/home/eza/Projects/niri-xmb/ports/noctalia-v5/plugins"

[bar.main]
start = ["niri-xmb-hdmi1", "niri-xmb-hdmi2"]

[widget.niri-xmb-hdmi1]
type = "amarinne/niri-xmb:workspace-strip"
target_output = "HDMI-A-1"
backend_command = "/home/eza/.local/bin/niri-xmb"
poll_interval_ms = 250
hide_empty_workspaces = false
allow_drag = true
allow_column_join = false
preserve_cursor_after_drag = true
show_active_indicator = true
icon_size = 22
group_opacity = 0.72

[widget.niri-xmb-hdmi2]
type = "amarinne/niri-xmb:workspace-strip"
target_output = "HDMI-A-2"
backend_command = "/home/eza/.local/bin/niri-xmb"
poll_interval_ms = 250
hide_empty_workspaces = false
allow_drag = true
allow_column_join = false
preserve_cursor_after_drag = true
show_active_indicator = true
icon_size = 22
group_opacity = 0.72
