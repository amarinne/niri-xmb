[Unit]
Description=Niri XMB workspace bar and navigator
Documentation=file://%h/Projects/niri-xmb/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/niri-xmb daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
