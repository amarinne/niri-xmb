[Unit]
Description=Niri XMB workspace bar and navigator
Documentation=https://github.com/amarinne/niri-xmb
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/niri-xmb daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
